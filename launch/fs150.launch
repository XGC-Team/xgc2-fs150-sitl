<?xml version="1.0"?>
<launch>
  <arg name="ID" default="3"/>
  <arg name="vehicle" default="iris"/>
  <arg name="px4_sim_model" default="iris"/>
  <arg name="model_name" default="fs150_$(arg ID)"/>
  <arg name="px4_launch" default="$(find gazebo_sim_px4_1_12)/launch/iris.launch"/>

  <arg name="gui" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="interactive" default="false"/>

  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0"/>
  <arg name="R" default="0"/>
  <arg name="P" default="0"/>
  <arg name="Y" default="0"/>

  <arg name="world" default="$(find gazebo_sim_px4_1_12)/worlds/empty.world"/>
  <arg name="sdf" default="$(find gazebo_sim_fs150_sitl)/models/fs150/iris.sdf"/>
  <arg name="work_dir" default="$(env HOME)/.xgc2/px4_sitl/$(arg model_name)"/>
  <arg name="param_file" default="$(find gazebo_sim_fs150_sitl)/config/generated/fs150-sitl.params"/>
  <arg name="reset_params" default="true"/>
  <arg name="sys_autostart" default=""/>
  <arg name="sim_speed_factor" default=""/>
  <arg name="home_lat" default=""/>
  <arg name="home_lon" default=""/>
  <arg name="uxrce_dds_ns" default=""/>
  <arg name="uxrce_dds_port" default=""/>

  <arg name="mav_system_id" default="$(eval int(arg('ID')) + 1)"/>
  <arg name="mavlink_tcp_port" default="$(eval 4560 + int(arg('ID')))"/>
  <arg name="mavlink_udp_port" default="$(eval 14560 + int(arg('ID')))"/>
  <arg name="qgc_udp_port" default="14550"/>
  <arg name="mavros_local_port" default="$(eval 15000 + int(arg('ID')))"/>
  <arg name="mavros_remote_port" default="$(eval 15300 + int(arg('ID')))"/>
  <arg name="sdk_udp_port" default="$(arg mavros_local_port)"/>

  <!-- PX4 instance N maps to MAV_SYS_ID=N+1 and MAVROS UDP ports 15000+N -> 15300+N (the PX4 runtime offboard segment). -->
  <arg name="fcu_url" default="$(eval 'udp://:' + str(arg('mavros_local_port')) + '@localhost:' + str(arg('mavros_remote_port')))"/>
  <arg name="gcs_url" default=""/>
  <arg name="ns" default="uav1"/>
  <arg name="mavros_tgt_system" default="$(arg mav_system_id)"/>
  <arg name="respawn_gazebo" default="false"/>
  <arg name="respawn_mavros" default="false"/>
  <arg name="start_gazebo" default="true"/>
  <arg name="sitl_node_name" default="sitl"/>

  <env name="GAZEBO_MODEL_PATH" value="$(find gazebo_sim_fs150_sitl)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(arg px4_launch)">
    <arg name="ID" value="$(arg ID)"/>
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="px4_sim_model" value="$(arg px4_sim_model)"/>
    <arg name="model_name" value="$(arg model_name)"/>
    <arg name="gazebo_model_path_extra" value="$(find gazebo_sim_fs150_sitl)/models"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="sdf" value="$(arg sdf)"/>
    <arg name="work_dir" value="$(arg work_dir)"/>
    <arg name="param_file" value="$(arg param_file)"/>
    <arg name="reset_params" value="$(arg reset_params)"/>
    <arg name="sys_autostart" value="$(arg sys_autostart)"/>
    <arg name="sim_speed_factor" value="$(arg sim_speed_factor)"/>
    <arg name="home_lat" value="$(arg home_lat)"/>
    <arg name="home_lon" value="$(arg home_lon)"/>
    <arg name="uxrce_dds_ns" value="$(arg uxrce_dds_ns)"/>
    <arg name="uxrce_dds_port" value="$(arg uxrce_dds_port)"/>
    <arg name="mav_system_id" value="$(arg mav_system_id)"/>
    <arg name="mavlink_tcp_port" value="$(arg mavlink_tcp_port)"/>
    <arg name="mavlink_udp_port" value="$(arg mavlink_udp_port)"/>
    <arg name="qgc_udp_port" value="$(arg qgc_udp_port)"/>
    <arg name="sdk_udp_port" value="$(arg sdk_udp_port)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="debug" value="$(arg debug)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="interactive" value="$(arg interactive)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="R" value="$(arg R)"/>
    <arg name="P" value="$(arg P)"/>
    <arg name="Y" value="$(arg Y)"/>
    <arg name="fcu_url" value="$(arg fcu_url)"/>
    <arg name="gcs_url" value="$(arg gcs_url)"/>
    <arg name="ns" value="$(arg ns)"/>
    <arg name="mavros_tgt_system" value="$(arg mavros_tgt_system)"/>
    <arg name="respawn_gazebo" value="$(arg respawn_gazebo)"/>
    <arg name="respawn_mavros" value="$(arg respawn_mavros)"/>
    <arg name="start_gazebo" value="$(arg start_gazebo)"/>
    <arg name="sitl_node_name" value="$(arg sitl_node_name)"/>
  </include>
</launch>
