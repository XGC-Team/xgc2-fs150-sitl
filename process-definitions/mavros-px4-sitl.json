{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "mavros-px4-sitl",
      "version": "4.0.0",
      "label": "MAVROS for PX4 SITL",
      "description": "Direct MAVROS node with trusted PX4 plugin and parameter files. The native SITL instance selects the matching MAVLink identity and offboard endpoint.",
      "parameters": {
        "groups": [
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri",
              "rosIp"
            ]
          },
          {
            "id": "runtime-advanced",
            "label": "Runtime Advanced",
            "collapsed": true,
            "parameters": [
              "rosRuntimePrefix"
            ]
          }
        ],
        "properties": {
          "sitlInstanceId": {
            "type": "integer",
            "description": "PX4 SITL instance; native MAVLink identity and offboard ports are derived from this value",
            "default": 0,
            "minimum": 0,
            "maximum": 243
          },
          "namespace": {
            "type": "string",
            "description": "Absolute frozen per-robot ROS namespace",
            "default": "/uav1"
          },
          "rosMasterUri": {
            "type": "string",
            "description": "Pre-allocated session ROS master URI",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosIp": {
            "type": "string",
            "description": "Reachable IPv4 address advertised by this MAVROS node",
            "default": "127.0.0.1",
            "output": true
          },
          "rosRuntimePrefix": {
            "type": "string",
            "description": "Trusted ROS runtime; the execution user's XGC overlay is discovered automatically",
            "default": "/opt/ros/noetic",
            "fixedOnly": true,
            "x-xgc-path-kind": "directory"
          },
          "useSimTime": {
            "type": "boolean",
            "default": false,
            "description": "Frozen Session clock selection; bound privately before node initialization."
          }
        },
        "required": []
      },
      "command": {
        "executable": "/usr/bin/python3",
        "args": [
          "/opt/ros/noetic/lib/gazebo_sim_fs150_sitl/start_mavros.py",
          "/opt/ros/noetic/lib/mavros/mavros_node",
          "${namespace}",
          "mavros",
          "/opt/ros/noetic/share/mavros/launch/px4_pluginlists.yaml,/opt/ros/noetic/share/mavros/launch/px4_config.yaml",
          "${sitlInstanceId}",
          "gcs_url="
        ],
        "env": {
          "ROS_IP": "${rosIp}",
          "ROS_MASTER_URI": "${rosMasterUri}",
          "XGC_ROS_USE_SIM_TIME": "${useSimTime}"
        }
      },
      "setupFiles": [
        "${rosRuntimePrefix}/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 8000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
