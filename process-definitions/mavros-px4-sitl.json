{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "mavros-px4-sitl",
      "version": "3.0.0",
      "label": "MAVROS for PX4 SITL",
      "description": "Direct MAVROS node with trusted PX4 plugin and parameter files. fcuUrl is supplied by the calling graph from the bound Robot asset simulation ports.",
      "parameters": {
        "groups": [
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri",
              "rosIp"
            ]
          },
          {
            "id": "runtime-advanced",
            "label": "Runtime Advanced",
            "collapsed": true,
            "parameters": [
              "rosRuntimePrefix"
            ]
          }
        ],
        "properties": {
          "fcuUrl": {
            "type": "string",
            "description": "Robot-owned SITL MAVROS endpoint (from simulationFcuUrl / simulationLink); not derived from sitlInstanceId",
            "default": "udp://:15000@127.0.0.1:15300"
          },
          "mavSystemId": {
            "type": "integer",
            "description": "Target MAVLink system ID",
            "default": 4,
            "minimum": 1,
            "maximum": 245
          },
          "namespace": {
            "type": "string",
            "description": "Absolute frozen per-robot ROS namespace",
            "default": "/uav1"
          },
          "rosMasterUri": {
            "type": "string",
            "description": "Absolute URI of the existing ROS master",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosIp": {
            "type": "string",
            "description": "Reachable IPv4 address advertised by this MAVROS node",
            "default": "127.0.0.1",
            "output": true
          },
          "rosRuntimePrefix": {
            "type": "string",
            "description": "Trusted ROS runtime; the execution user's XGC overlay is discovered automatically",
            "default": "/opt/ros/noetic",
            "fixedOnly": true,
            "x-xgc-path-kind": "directory"
          }
        },
        "required": []
      },
      "command": {
        "executable": "/usr/bin/python3",
        "args": [
          "/opt/ros/noetic/lib/gazebo_sim_fs150_sitl/start_mavros.py",
          "/opt/ros/noetic/lib/mavros/mavros_node",
          "${namespace}",
          "mavros",
          "/opt/ros/noetic/share/mavros/launch/px4_pluginlists.yaml,/opt/ros/noetic/share/mavros/launch/px4_config.yaml",
          "fcu_url=${fcuUrl}",
          "gcs_url=",
          "target_system_id=${mavSystemId}",
          "target_component_id=1"
        ],
        "env": {
          "ROS_IP": "${rosIp}",
          "ROS_MASTER_URI": "${rosMasterUri}"
        }
      },
      "setupFiles": [
        "${rosRuntimePrefix}/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 8000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
